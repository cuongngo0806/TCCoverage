{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tcadvisor verification results block (report.html #results, report.json .test_results)",
  "type": "object",
  "required": ["schema", "report_key", "results", "attachments"],
  "properties": {
    "schema": {"const": 1},
    "report_key": {"type": "string"},
    "generated_at": {"type": "string"},
    "attachment_warn_mb": {"type": "integer", "minimum": 1},
    "results": {"type": "object", "additionalProperties": {"$ref": "#/definitions/record"}},
    "orphaned_results": {
      "type": "object",
      "additionalProperties": {
        "allOf": [{"$ref": "#/definitions/record"},
                  {"type": "object", "properties": {"last_description": {"type": "string"}}}]
      }
    },
    "attachments": {"type": "object", "additionalProperties": {"$ref": "#/definitions/attachment"}}
  },
  "definitions": {
    "record": {
      "type": "object",
      "properties": {
        "verdict": {"enum": ["pass", "fail", "not_testable", "cannot_occur", null]},
        "comment": {"type": "string"},
        "tester": {"type": "string"},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "defect_ref": {"type": "string"},
        "attachments": {"type": "array", "items": {"type": "string"}},
        "needs_recheck": {"type": "boolean"},
        "carried_from": {"type": ["string", "null"]},
        "updated_at": {"type": "string"}
      }
    },
    "attachment": {
      "type": "object",
      "required": ["name", "type", "size", "sha256", "data"],
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "data": {"type": "string", "contentEncoding": "base64"},
        "added_at": {"type": "string"}
      }
    }
  }
}
