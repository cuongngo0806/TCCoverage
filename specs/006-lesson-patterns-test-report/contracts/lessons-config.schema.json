{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tcadvisor lessons config (.tcadvisor/lessons.json)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sinks": {
      "description": "Extra emitting points: exact qualified/short names or fnmatch patterns",
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "when", "ask"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,40}$"},
          "title": {"type": "string", "minLength": 1},
          "when": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "tokens_any": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "name_glob": {"type": "string"},
              "path_glob": {"type": "string"},
              "sub_reason": {"type": "string"}
            }
          },
          "ask": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
