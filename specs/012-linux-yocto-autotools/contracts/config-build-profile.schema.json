{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tcadvisor .tcadvisor/config.json — build profile (spec 012)",
  "type": "object",
  "properties": {
    "output_dir": {"type": "string", "description": "report root; default .tcadvisor/reports; one run folder per analysis"},
    "build": {
      "type": "object",
      "required": ["system", "confirmed", "variants"],
      "additionalProperties": false,
      "properties": {
        "system": {"enum": ["auto", "cmake", "autotools"]},
        "confirmed": {"type": "boolean"},
        "confirmed_at": {"type": "string", "format": "date-time"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "variants": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {
            "type": "object", "required": ["name"], "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
              "compile_db": {"type": "string"},
              "build_log": {"type": "string"},
              "log_sha256": {"type": "string"},
              "build_dir": {"type": "string"},
              "values": {"type": "object", "additionalProperties": {"type": ["string", "boolean", "null"]}},
              "value_source": {"type": "object", "additionalProperties": {"enum": ["build", "user"]}}
            }
          }
        }
      }
    }
  }
}
